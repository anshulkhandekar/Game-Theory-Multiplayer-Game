# Example only. Set variables in Railway or use node --env-file=.env server/index.js.
NODE_ENV=production
HOST_KEY=replace-with-an-independent-random-host-secret
EVENT_CODE=replace-with-a-strong-attendee-code
SPECTATOR_KEY=replace-with-an-independent-random-viewer-secret
PORT=3000
# On Railway mount /data and set STATE_FILE=/data/workshop.json.
STATE_FILE=data/state.json
